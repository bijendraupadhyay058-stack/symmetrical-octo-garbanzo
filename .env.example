# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# Only the PUBLIC anon key belongs here. NEVER put the service_role key in any
# NEXT_PUBLIC_ variable or anywhere in this frontend project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the deployed site (used for password-reset redirect links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: set to "true" to allow the app to run without Supabase using only
# on-device storage (useful for trying the app / demo). Leave unset in production.
NEXT_PUBLIC_ALLOW_LOCAL_MODE=false
